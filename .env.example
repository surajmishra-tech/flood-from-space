# Copy this file to .env and fill in your own values. Never push .env to GitHub.

# Where satellite images come from:
#   cdse = Copernicus Data Space (Sentinel Hub API, needs the 2 values below)
#   pc   = Microsoft Planetary Computer (no account needed, backup)
DATA_SOURCE=pc

# Copernicus Data Space -> Sentinel Hub dashboard -> User settings -> OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Groq (for the situation-report copilot). Get it at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ohsome API v2 key (free): https://account.heigit.org/signup
OHSOME_API_KEY=

# Optional: a PIN the rescue team types to see help requests (names, phones, locations).
# Empty = no PIN, which is fine only on a private computer.
RESCUE_PIN=

# Optional: your free permanent ngrok address (dashboard.ngrok.com -> Domains), used by serve_live.bat
NGROK_DOMAIN=
